# Affiche le petit libellé "Aperçu de design" et bloque l'indexation.
# Mettre "false" uniquement après accord écrit du salon.
NEXT_PUBLIC_PREVIEW_MODE=true

# URL de production réelle (laisser vide tant que le domaine n'est pas connu).
# Quand elle est renseignée, elle sert de metadataBase pour les liens canoniques et Open Graph.
NEXT_PUBLIC_SITE_URL=
